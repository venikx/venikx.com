---
import Layout from '../../layouts/Layout.astro'
import PostList from '../../components/PostList.astro'
import FeedLink from '../../components/FeedLink.astro'
import { FEEDS } from '../../lib/feed'
import { getAllPosts } from '../../lib/posts'

const allBlogPosts = await getAllPosts()
---

<Layout
  title="writing on Nix, graphics & game dev | Kevin De Baerdemaeker"
  description="Posts on Nix, graphics programming and game dev by Kevin De Baerdemaeker."
>
  <div class="flex items-baseline justify-between gap-4">
    <h1 class="text-4xl">Writing</h1>
    <FeedLink feed={FEEDS.posts} />
  </div>
  <p>Posts on Nix, graphics programming and game dev.</p>
  <PostList posts={allBlogPosts} />
</Layout>
