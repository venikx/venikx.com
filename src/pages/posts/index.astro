---
import Layout from '../../layouts/Layout.astro'
import PostList from '../../components/PostList.astro'
import FeedLink from '../../components/FeedLink.astro'
import { FEEDS } from '../../lib/feed'
import { getAllPosts } from '../../lib/posts'

const allBlogPosts = await getAllPosts()
---

<Layout
  title="Posts | Kevin De Baerdemaeker"
  description="Curated deep dives, for when I really want to understand or share a topic."
>
  <div class="flex items-baseline justify-between gap-4">
    <h1 class="text-4xl">All Posts</h1>
    <FeedLink feed={FEEDS.posts} />
  </div>
  <PostList posts={allBlogPosts} />
</Layout>
