---
import { render } from 'astro:content'
import { Image } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import { getAllPosts } from '../../lib/posts'

export async function getStaticPaths() {
  return getAllPosts().then((allPosts) => {
    return allPosts.map((entry) => {
      return {
        params: {
          slug: entry.id,
        },
        props: { entry },
      }
    })
  })
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Layout
  kind="article"
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.cover}
  modified={entry.data.modified ?? entry.data.created}
>
  <h1 class="text-4xl max-w-prose mb-8">{entry.data.title}</h1>
  {
    entry.data.cover && (
      <Image
        src={entry.data.cover}
        alt=""
        widths={[640, 960, 1280, 1792]}
        sizes="(min-width: 56rem) 56rem, 100vw"
        priority
        class="w-full aspect-[2.39/1] object-cover mb-8"
      />
    )
  }
  <div
    class="prose prose-hackerman prose-a:transition-colors prose-a:rounded-xs prose-a:ease-in prose-a:duration-200 hover:prose-a:bg-pink-100"
  >
    <Content />
  </div>
</Layout>
