---
import { getEntry, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import FeedLink from '../../components/FeedLink.astro'
import { INDEX } from '../../lib/braindump'
import { FEEDS } from '../../lib/feed'

const index = await getEntry('braindump', INDEX)
const IndexContent = index && (await render(index)).Content
---

<Layout
  title="Brain: a messy dump | Kevin De Baerdemaeker"
  description="My braindump: rough, linked notes to learn, understand and retain the things I'm interested in. Messy, unfinished and always growing."
>
  <div class="flex items-baseline justify-between gap-4 mb-8">
    <h1 class="text-4xl max-w-prose">Brain</h1>
    <FeedLink feed={FEEDS.braindump} />
  </div>
  {
    IndexContent && (
      <div class="prose prose-hackerman prose-a:transition-colors prose-a:rounded-xs prose-a:ease-in prose-a:duration-200 hover:prose-a:bg-pink-100">
        <IndexContent />
      </div>
    )
  }
  <section class="mt-12">
    <hr class="border-pink-200 border-2" />
    <p>
      Every note is listed in the
      <a
        href="/braindump/archive/"
        class="text-pink-700 underline transition-colors ease-in duration-200 rounded-xs hover:bg-pink-100"
        >Archive</a
      >.
    </p>
  </section>
</Layout>
