---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import bioImage from '../assets/pixel-art-kevin-db.webp'
import PostList from '../components/PostList.astro'
import Link from '../components/Link.astro'
import { getAllPosts } from '../lib/posts'
import { SECTIONS } from '../lib/sections'

const latestPosts = await getAllPosts().then((allPosts) => allPosts.slice(0, 5))
---

<Layout
  title="Kevin De Baerdemaeker | Hackerspace"
  description="Kevin's personal hackerspace: writing, a braindump of linked notes and creative coding experiments."
>
  <div class="flex items-center -mt-2">
    <Image
      class="-ml-2 w-32 h-32 mr-4"
      src={bioImage}
      alt=""
      width={320}
      loading="eager"
    />
    <p>
      <em>Welcome! Hi!</em> This is my hackerspace. It's where I poke at whatever
      I find interesting, be it graphics programming, Nix or game dev, and keep writing
      about it until it <em>sticks</em>. Some of it is polished, most of it
      isn't.
    </p>
  </div>

  <h2 class="text-2xl">What's in here</h2>
  <ul class="list-[square] list-inside">
    {
      SECTIONS.map((s) => (
        <li>
          <Link href={s.href}>{s.label}</Link>: {s.blurb}
        </li>
      ))
    }
  </ul>

  <h2 class="text-2xl">Latest Writing</h2>
  <PostList posts={latestPosts} />
</Layout>
