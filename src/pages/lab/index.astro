---
import Layout from '../../layouts/Layout.astro'
import PostList from '../../components/PostList.astro'
import FeedLink from '../../components/FeedLink.astro'
import { getAllExperiments } from '../../lib/experiments'
import { FEEDS } from '../../lib/feed'

const experiments = getAllExperiments()
---

<Layout
  title="Lab: creative coding & digital art | Kevin De Baerdemaeker"
  description="Creative coding experiments. Self-contained toys, mostly canvas and digital art, but anything goes."
>
  <div class="flex items-baseline justify-between gap-4">
    <h1 class="text-4xl">Lab</h1>
    <FeedLink feed={FEEDS.experiments} />
  </div>
  <p>
    Creative coding experiments. Self-contained toys, each one its own page with
    dependencies. Mostly canvas and digital art, but anything goes.
  </p>
  <PostList posts={experiments} base="/lab/" />
</Layout>
