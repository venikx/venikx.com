---
import Layout from '../../layouts/Layout.astro'
import { getAllExperiments } from '../../lib/experiments'

// NOTE(venikx): Only pass params, astro dev caches getStaticPaths props, so
// passing the experiment as props serves a stale version until a restart.
export function getStaticPaths() {
  return getAllExperiments().map(({ id }) => ({ params: { slug: id } }))
}

const experiment = getAllExperiments().find((e) => e.id === Astro.params.slug)
if (!experiment) throw new Error(`unknown experiment: ${Astro.params.slug}`)
const { data, Content } = experiment
---

<Layout
  bare={data.fullscreen}
  kind="article"
  title={data.title}
  description={data.description}
  modified={data.modified ?? data.created}
>
  {
    data.fullscreen ? (
      <Content />
    ) : (
      <>
        <h1 class="text-4xl max-w-prose mb-8">{data.title}</h1>
        <div class="prose prose-hackerman prose-a:transition-colors prose-a:rounded-xs prose-a:ease-in prose-a:duration-200 hover:prose-a:bg-pink-100">
          <Content />
        </div>
      </>
    )
  }
</Layout>
